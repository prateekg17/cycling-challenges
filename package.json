{
  "name": "tube-cycling-challenge",
  "version": "1.0.0",
  "description": "A GitHub Pages application that displays cycling activities for the Tube Cycling Challenge via scheduled Strava API fetching.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:frontend": "tsc -p tsconfig.frontend.json && node scripts/prepare-site.ts",
    "fetch-activities": "tsc && node dist/fetch-activities.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "keywords": [
    "strava",
    "cycling",
    "github-pages",
    "tube",
    "london"
  ],
  "author": "Prateek",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
